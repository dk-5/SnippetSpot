{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnippetSpot",
  "version": "0.1.3",
  "identifier": "com.snippetspot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "popup",
        "title": "SnippetSpot",
        "width": 680,
        "height": 460,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Fast, local search for apps, snippets and vault credentials",
    "longDescription": "A fast, local-only search bar for your apps, text snippets and vault credentials. Press Alt+Space and type to paste a result into any application.",
    "copyright": "Copyright (c) 2026 Dhruv",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3NjhCNEM0Q0EyMjM2QzMKUldURE5pTEt4TFJvTjgrNFlhMnJNNzMrK2syWldEY0VxalpzR1BHNm11S1hBK1c2d1AzTXpLbTAK",
      "endpoints": ["https://snippetspot.netlify.app/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
